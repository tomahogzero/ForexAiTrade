      "properties":{"outcome_record_integrity":{"const":"PROVEN"},"descriptive_statistics_integrity":{"const":"PROVEN"},"descriptive_interpretation":{"const":"ALLOWED_UNDER_FROZEN_CONTRACT"},"strategy_edge":{"const":"NOT_ESTABLISHED"},"robustness":{"const":"NOT_ESTABLISHED"},"performance":{"const":"NOT_EVALUATED"},"profitability":{"const":"NOT_CLAIMED"},"order_logic":{"const":"NOT_APPROVED"},"candidate":{"const":"NOT_READY_FOR_ORDER_LOGIC"},"next_allowed_scope":{"const":"SEALED_OBSERVATIONAL_OUTCOME_INTERPRETATION_REPORT_ONLY"}},
