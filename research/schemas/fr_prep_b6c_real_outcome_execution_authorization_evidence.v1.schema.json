        "real_outcome_execution_started":{"const":false},"real_future_prices_inspected":{"const":false},
        "real_outcome_records_generated":{"const":false},"performance":{"const":"NOT_EVALUATED"},
        "profitability":{"const":"NOT_CLAIMED"},"order_logic":{"const":"NOT_APPROVED"},
        "candidate":{"const":"NOT_READY_FOR_ORDER_LOGIC"},"next_allowed_scope":{"const":"SEALED_REAL_OBSERVATIONAL_OUTCOME_EXECUTION_ONLY"}
      },"additionalProperties":false
    },
    "negative_tests":{
      "type":"object","required":["all_passed","test_count","tests_passed","results"],
      "properties":{"all_passed":{"const":true},"test_count":{"minimum":10},"tests_passed":{"minimum":10},"results":{"type":"object"}}
    },
    "mismatch_counters":{"type":"object","additionalProperties":{"const":0}},
    "absolute_runtime_path_in_canonical_identity_count":{"const":0},
    "prohibited_modules":{"type":"array","maxItems":0},
    "upstream_validation":{"type":"object"},"adapter_binding":{"type":"object"},"datasets":{"type":"object"},
    "sealed_outcome_contract":{"type":"object"},"authorized_next_checkpoint_operations":{"type":"array","minItems":8,"maxItems":8},
    "still_prohibited":{"type":"array","minItems":9},"runtime_audit":{"type":"object"}
  },
  "additionalProperties":false
