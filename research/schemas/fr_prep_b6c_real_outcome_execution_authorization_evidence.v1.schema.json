{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fr_prep_b6c_real_outcome_execution_authorization_evidence.v1.schema.json",
  "type": "object",
  "required": ["schema_version","checkpoint","decision","execution_status","canonical_summary_sha256","upstream_validation","adapter_binding","datasets","sealed_outcome_contract","authorized_next_checkpoint_operations","still_prohibited","authorization_states","negative_tests","mismatch_counters","runtime_audit","absolute_runtime_path_in_canonical_identity_count","prohibited_modules"],
