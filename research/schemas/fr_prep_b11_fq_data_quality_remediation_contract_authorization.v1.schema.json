        "b10a",
        "fq"
      ],
      "type": "object"
    },
    "prohibited_input_paths": {
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "schema_version": {
      "const": "fr_prep_b11_fq_data_quality_remediation_contract_authorization.v1"
