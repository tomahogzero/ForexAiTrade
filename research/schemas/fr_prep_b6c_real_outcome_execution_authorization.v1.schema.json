{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fr_prep_b6c_real_outcome_execution_authorization.v1.schema.json",
  "type": "object",
  "required": ["schema_version","checkpoint","authorization_scope","decision_on_pass","adapter_binding","committed_artifacts","expected","authorized_next_checkpoint_operations","still_prohibited"],
  "properties": {
    "schema_version": {"const":"fr_prep_b6c_real_outcome_execution_authorization.v1"},
    "checkpoint": {"const":"FR_PREP_B6C"},
    "authorization_scope": {"const":"NEXT_CHECKPOINT_ONLY"},
    "decision_on_pass": {"const":"FR_PREP_B6C_PASS_REAL_OUTCOME_EXECUTION_AUTHORIZATION_SEALED"},
    "adapter_binding": {
      "type":"object",
      "required":["path","file_sha256"],
      "properties":{"path":{"const":"tools/observational_outcome_adapter.py"},"file_sha256":{"pattern":"^[0-9a-f]{64}$"}},
      "additionalProperties":false
    },
    "committed_artifacts": {
      "type":"array","minItems":29,"maxItems":29,
      "items":{
        "type":"object","required":["artifact_id","category","path","file_sha256","read_mode"],
        "properties":{
          "artifact_id":{"type":"string"},"category":{"type":"string"},"path":{"type":"string","pattern":"^(research|tools)/"},
          "file_sha256":{"pattern":"^[0-9a-f]{64}$"},"read_mode":{"enum":["json","hash_only"]}
        },"additionalProperties":false
      }
    },
    "expected":{
      "type":"object","required":["upstream_identities","adapter","datasets","dataset_request_bindings","outcome_contract","authorization_states"]
    },
    "authorized_next_checkpoint_operations":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"string"}},
    "still_prohibited":{"type":"array","minItems":9,"items":{"type":"string"}}
  },
  "additionalProperties":false
}
