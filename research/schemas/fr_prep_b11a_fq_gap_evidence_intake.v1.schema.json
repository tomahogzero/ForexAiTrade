{
  "$id": "fr_prep_b11a_fq_gap_evidence_intake.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_runtime_path_in_canonical_identity_count": {
      "const": 0
    },
    "canonical_summary_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint": {
      "const": "FR_PREP_B11A"
    },
    "conclusions": {
      "properties": {
        "candidate": {
          "const": "NOT_READY_FOR_ORDER_LOGIC"
        },
        "evidence_intake_baseline": {
          "const": "CREATED"
        },
        "gap_adjudication": {
          "const": "NOT_STARTED"
        },
        "gap_reclassification": {
          "const": "NOT_STARTED"
        },
        "order_logic": {
          "const": "NOT_APPROVED"
        },
        "original_gap_inventory_immutable": {
          "const": true
        },
        "outcome_rerun": {
          "const": "NOT_AUTHORIZED"
        },
        "performance": {
          "const": "NOT_EVALUATED"
        },
        "profitability": {
          "const": "NOT_CLAIMED"
        },
        "synthetic_bar_creation": {
          "const": "PROHIBITED"
        },
        "target_dataset": {
          "const": "FP_FQ_2020_2022_GOLD_H1"
        },
        "target_gap_count": {
          "const": 625
        },
        "timeline_rebuild": {
          "const": "NOT_STARTED"
        }
      },
      "required": [
        "evidence_intake_baseline",
        "target_dataset",
        "target_gap_count",
        "original_gap_inventory_immutable",
        "evidence_packages_registered",
        "primary_packages_registered",
        "corroborative_packages_registered",
        "gaps_with_primary_evidence",
        "gaps_without_primary_evidence",
        "gap_adjudication",
        "gap_reclassification",
        "timeline_rebuild",
        "outcome_rerun",
        "synthetic_bar_creation",
        "performance",
        "profitability",
        "order_logic",
        "candidate"
      ],
      "type": "object"
    },
    "decision": {
      "const": "FR_PREP_B11A_PASS_FQ_GAP_REMEDIATION_EVIDENCE_INTAKE_BASELINE"
    },
    "determinism": {
      "properties": {
        "controlled_relocation_identical": {
          "const": true
        },
        "normal_repeat_identical": {
          "const": true
        },
        "temporary_artifacts_deleted": {
          "const": true
        }
      },
      "required": [
        "normal_repeat_identical",
        "controlled_relocation_identical",
        "temporary_artifacts_deleted"
      ],
      "type": "object"
    },
    "execution_status": {
      "const": "PASS"
    },
    "intake_state": {
      "required": [
        "intake_batch_status",
        "evidence_intake_complete",
        "next_allowed_scope",
        "package_counts",
        "gap_counts"
      ],
      "type": "object"
    },
    "mismatch_counters": {
      "additionalProperties": {
        "const": 0
      },
      "type": "object"
    },
    "negative_tests": {
      "properties": {
        "all_passed": {
          "const": true
        }
      },
      "required": [
        "test_count",
        "tests_passed",
        "all_passed",
        "results"
      ],
      "type": "object"
    },
    "output_hashes": {
      "required": [
        "registry_sha256",
        "request_manifest_sha256",
        "target_matrix_sha256",
        "complete_sha256"
      ],
      "type": "object"
    },
    "prohibited_modules": {
      "maxItems": 0,
      "type": "array"
    },
    "runtime_audit": {
      "type": "object"
    },
    "schema_version": {
      "const": "fr_prep_b11a_fq_gap_evidence_intake.v1"
    },
    "target_validation": {
      "properties": {
        "target_gap_count": {
          "const": 625
        },
        "target_ids_unique": {
          "const": true
        },
        "targets_remain_unverified_gap": {
          "const": true
        }
      },
      "required": [
        "target_gap_count",
        "target_ids_unique",
        "targets_remain_unverified_gap",
        "target_gap_id_set_sha256",
        "target_gap_metadata_sha256",
        "structural_signature_inventory_sha256"
      ],
      "type": "object"
    },
    "upstream_validation": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "checkpoint",
    "decision",
    "execution_status",
    "canonical_summary_sha256",
    "upstream_validation",
    "target_validation",
    "intake_state",
    "output_hashes",
    "determinism",
    "conclusions",
    "negative_tests",
    "mismatch_counters",
    "runtime_audit",
    "absolute_runtime_path_in_canonical_identity_count",
    "prohibited_modules"
  ],
  "type": "object"
}
