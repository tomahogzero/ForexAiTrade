    "checkpoint":{"const":"FR_PREP_B6C"},
    "decision":{"const":"FR_PREP_B6C_PASS_REAL_OUTCOME_EXECUTION_AUTHORIZATION_SEALED"},
    "execution_status":{"const":"PASS"},
    "canonical_summary_sha256":{"pattern":"^[0-9a-f]{64}$"},
    "authorization_states":{
      "type":"object","required":["authorization_sealed","real_outcome_execution_authorized_for_next_checkpoint","real_outcome_execution_started","real_future_prices_inspected","real_outcome_records_generated","performance","profitability","order_logic","candidate","next_allowed_scope"],
