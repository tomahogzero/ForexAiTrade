{
  "$id":"fr_prep_b6_observational_outcome_contract.v1.schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "additionalProperties":false,
  "properties":{
    "absolute_runtime_path_in_canonical_identity_count":{"const":0},
    "aggregation_contract":{"const":{
      "dataset_pooling_allowed":false,
      "descriptive_statistics":["mean_bps","median_bps","p25_bps","p75_bps","positive_share","zero_share","negative_share"],
      "evaluation_coverage_formula":"evaluable_events / total_events",
      "group_dimensions":["dataset_id","direction","year","horizon_valid_h1_bars"],
      "hypothesis_selection_after_outcomes_allowed":false,
      "performance_pass_fail_threshold":null,
      "quantile_method":"R7_LINEAR_INTERPOLATION",
      "report_counts":["total_events","evaluable_events"],
      "share_classification":"QUANTIZED_BPS_GREATER_THAN_EQUAL_TO_LESS_THAN_ZERO",
      "statistics_input":"EVALUABLE_QUANTIZED_BASIS_POINT_VALUES_ONLY",
      "year_dimension":"YEAR_OF_CONFIRMATION_TIMESTAMP"
    }},
    "atr_events_generated":{"const":false},
    "b5_binding":{"const":{
      "canonical_summary_sha256":"915ed724f35ee106f7a78e8618f2d69d2795b4b25cc8278bf4773efd74b27a03",
      "contract_schema_validated":true,
      "data_quality_comparability":"MATERIAL_LIMITATION",
      "decision":"FR_PREP_B5_CONDITIONAL_PASS_TO_OUTCOME_CONTRACT_DESIGN_ONLY",
      "fj_events":1079,
      "fq_events":493,
      "identity_validated":true,
      "performance":"NOT_EVALUATED",
      "profitability":"NOT_CLAIMED",
      "result_projection_validated":true
    }},
    "canonical_summary_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checkpoint":{"const":"FR_PREP_B6"},
    "conclusions":{"const":{
      "candidate":"NOT_READY_FOR_ORDER_LOGIC",
      "next_allowed_scope":"SYNTHETIC_OUTCOME_ADAPTER_FIXTURES_ONLY",
      "order_logic":"NOT_APPROVED",
      "outcome_contract_design":"FROZEN",
      "outcome_execution":"NOT_STARTED",
      "performance":"NOT_EVALUATED",
      "profitability":"NOT_CLAIMED"
    }},
    "decision":{"const":"FR_PREP_B6_PASS_OBSERVATIONAL_OUTCOME_CONTRACT_FROZEN"},
    "direction_normalized_return":{"const":{
      "basis_point_multiplier":"10000",
      "future_price_field":"future_close",
      "long_formula_bps":"((future_close - entry_price) / entry_price) * 10000",
      "short_formula_bps":"((entry_price - future_close) / entry_price) * 10000",
      "unit":"BASIS_POINTS"
    }},
    "ea_executed":{"const":false},
    "execution_status":{"const":"PASS"},
    "evaluability_contract":{"const":{
      "accepted_weekend_or_session_closure_effect":"DOES_NOT_INVALIDATE_AND_DOES_NOT_COUNT_AS_A_VALID_BAR",
      "all_events_retained":true,
      "event_status_values":["FULLY_EVALUABLE","PARTIALLY_EVALUABLE","NOT_EVALUABLE"],
      "fail_closed_statuses":{
        "invalid_or_nonfinite_ohlc":"NOT_EVALUABLE_SOURCE_INTEGRITY",
        "insufficient_future_valid_h1_bars":"NOT_EVALUABLE_RIGHT_CENSORING",
        "unverified_gap_crossed_before_target_horizon":"NOT_EVALUABLE_DATA_INCOMPLETE_GAP"
      },
      "horizon_evaluable_status":"EVALUABLE",
      "horizon_status_resolution":"SCAN_CHRONOLOGICALLY_AFTER_CONFIRMATION; FIRST_UNVERIFIED_GAP_OR_INVALID_OHLC_BLOCKS; IF_NO_BLOCKER_AND_TOO_FEW_VALID_BARS_USE_RIGHT_CENSORING",
      "invalid_entry_source_status":"NOT_EVALUABLE_SOURCE_INTEGRITY",
      "unverified_gap_crossing_interval":"ENTRY_TIMESTAMP_EXCLUSIVE_TO_TARGET_BAR_TIMESTAMP_INCLUSIVE"
    }},
    "event_entry_contract":{"const":{
      "entry_price_field":"confirmation_close",
      "entry_reference_equality":"entry_reference_price == confirmation_close",
      "entry_timestamp_field":"confirmation_timestamp",
      "evaluation_independence":"EACH_EVENT_EVALUATED_INDEPENDENTLY",
      "immutable_join_key":"event_id",
      "position_simulation":false
    }},
    "excursion_contract":{"const":{
      "basis_point_multiplier":"10000",
      "future_window":"FIRST_12_VALID_H1_BARS_AFTER_CONFIRMATION",
      "long_mae_formula_bps":"max(0, (entry_price - min_future_low) / entry_price) * 10000",
      "long_mfe_formula_bps":"max(0, (max_future_high - entry_price) / entry_price) * 10000",
      "non_negative":true,
      "non_negative_policy":"MAX_WITH_ZERO_BEFORE_BPS_QUANTIZATION",
      "short_mae_formula_bps":"max(0, (max_future_high - entry_price) / entry_price) * 10000",
      "short_mfe_formula_bps":"max(0, (entry_price - min_future_low) / entry_price) * 10000",
      "unit":"BASIS_POINTS",
      "window_high_field":"future_high",
      "window_low_field":"future_low"
    }},
    "explicit_exclusions":{"const":[
      "SPREAD","COMMISSION","SWAP","SLIPPAGE","CASH_PNL","LOT_SIZING","ACCOUNT_BALANCE",
      "TP_SL","ORDER_SIMULATION","OVERLAPPING_POSITION_RULES","PROFITABILITY_CONCLUSION",
      "TRADING_READINESS_CONCLUSION"
    ]},
    "fn_interpretation_performed":{"const":false},
    "future_prices_inspected":{"const":false},
    "horizon_contract":{"const":{
      "descriptive_observations_not_trade_exits":true,
      "immutable_after_checkpoint":true,
      "target_valid_h1_bars_after_confirmation":[1,3,6,12],
      "timeframe":"H1",
      "valid_bar_selection":"STRICTLY_AFTER_CONFIRMATION_IN_CHRONOLOGICAL_SOURCE_ORDER"
    }},
    "mismatch_counters":{"type":"object","minProperties":8,"additionalProperties":{"const":0}},
    "mt5_executed":{"const":false},
    "negative_tests":{
      "type":"object","additionalProperties":false,"required":["test_count","tests_passed","all_passed","results"],
      "properties":{
        "test_count":{"const":8},"tests_passed":{"const":8},"all_passed":{"const":true},
        "results":{"type":"object","minProperties":8,"additionalProperties":{"const":true}}
      }
    },
    "numeric_and_canonical_policy":{"const":{
      "absolute_runtime_paths_excluded":true,
      "arithmetic":"DECIMAL_FROM_SOURCE_STRINGS",
      "basis_point_quantization_decimal_places":6,
      "basis_point_quantum":"0.000001",
      "canonical_json":{"ensure_ascii":true,"separators":[",",":"],"sort_keys":true},
      "rounding":"ROUND_HALF_EVEN"
    }},
    "optimization_performed":{"const":false},
    "outcome_execution_count":{"const":0},
    "outcome_records_generated":{"const":false},
    "output_record_contract":{"const":{
      "event_level_status_required":true,
      "excursion_12_fields":["status","mfe_bps","mae_bps"],
      "horizon_result_fields":["horizon_valid_h1_bars","target_timestamp","status","direction_normalized_return_bps"],
      "horizon_result_keys":["1","3","6","12"],
      "immutable_event_join_key":"event_id",
      "one_record_per_input_event":true,
      "status_fields_never_null":true
    }},
    "performance_threshold":{"const":null},
    "prohibited_modules":{"type":"array","maxItems":0},
    "raw_csv_accessed":{"const":false},
    "runtime_audit":{
      "type":"object","additionalProperties":false,
      "required":["module_import_counts","prohibited_execution_counts","external_process","blocked_import_requests","file_access","counter_provenance"],
      "properties":{
        "module_import_counts":{"type":"object","minProperties":8,"additionalProperties":{"const":0}},
        "prohibited_execution_counts":{"type":"object","minProperties":14,"additionalProperties":{"const":0}},
        "external_process":{"type":"object","additionalProperties":false,"required":["successful_launch_count","blocked_launch_count"],"properties":{"successful_launch_count":{"const":0},"blocked_launch_count":{"minimum":1}}},
        "blocked_import_requests":{"minimum":1},
        "file_access":{"type":"object","additionalProperties":false,"required":["unique_logical_file_counts","raw_read_operation_counts","unauthorized_successful_read_count"],"properties":{"unique_logical_file_counts":{"type":"object"},"raw_read_operation_counts":{"type":"object"},"unauthorized_successful_read_count":{"const":0}}},
        "counter_provenance":{"type":"object","minProperties":4,"additionalProperties":{"type":"string","minLength":1}}
      }
    },
    "schema_version":{"const":"fr_prep_b6_observational_outcome_contract.v1"},
    "strategy_or_indicator_changes":{"const":false},
    "tp_sl_calculated":{"const":false}
  },
  "required":[
    "schema_version","checkpoint","decision","b5_binding","event_entry_contract","horizon_contract",
    "direction_normalized_return","excursion_contract","evaluability_contract","output_record_contract",
    "aggregation_contract","numeric_and_canonical_policy","explicit_exclusions","conclusions",
    "mismatch_counters","negative_tests","runtime_audit","prohibited_modules","execution_status",
    "future_prices_inspected","outcome_records_generated","outcome_execution_count","performance_threshold",
    "raw_csv_accessed","atr_events_generated","tp_sl_calculated","fn_interpretation_performed",
    "optimization_performed","strategy_or_indicator_changes","mt5_executed","ea_executed",
    "absolute_runtime_path_in_canonical_identity_count","canonical_summary_sha256"
  ],
  "type":"object"
}
