{
  "$id": "fr_prep_b5_event_population_research_decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute_runtime_path_in_canonical_identity_count":{"const":0},
    "atr_events_generated":{"const":false},
    "canonical_summary_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checkpoint":{"const":"FR_PREP_B5"},
    "conclusions":{"$ref":"#/$defs/conclusions"},
    "cross_period_comparison":{"$ref":"#/$defs/comparison"},
    "decision":{"const":"FR_PREP_B5_CONDITIONAL_PASS_TO_OUTCOME_CONTRACT_DESIGN_ONLY"},
    "ea_executed":{"const":false},
    "evidence_validation":{
      "type":"object","additionalProperties":false,"required":["b2","b2a","b4","b4a"],
      "properties":{"b2":{"$ref":"#/$defs/evidence"},"b2a":{"$ref":"#/$defs/evidence"},"b4":{"$ref":"#/$defs/evidence"},"b4a":{"$ref":"#/$defs/evidence"}}
    },
    "execution_status":{"const":"PASS"},
    "explicit_statements":{
      "type":"object","additionalProperties":false,
      "required":["operational_generalization","density_interpretation_limit","data_quality_limit","trading_conclusion_limit"],
      "properties":{
        "operational_generalization":{"const":"The detector generalizes operationally by producing deterministic, independently audited events in both periods."},
        "density_interpretation_limit":{"const":"The lower FQ event density cannot be interpreted as better or worse performance."},
        "data_quality_limit":{"const":"The 625 unverified FQ gaps materially limit direct comparability."},
        "trading_conclusion_limit":{"const":"No trading, profitability or order-readiness conclusion is permitted."}
      }
    },
    "fj":{"$ref":"#/$defs/fj_metrics"},
    "fn_interpretation_performed":{"const":false},
    "fq":{"$ref":"#/$defs/fq_metrics"},
    "mismatch_counters":{"type":"object","minProperties":8,"additionalProperties":{"const":0}},
    "mt5_executed":{"const":false},
    "negative_tests":{
      "type":"object","additionalProperties":false,"required":["test_count","tests_passed","all_passed","results"],
      "properties":{
        "test_count":{"const":8},"tests_passed":{"const":8},"all_passed":{"const":true},
        "results":{"type":"object","minProperties":8,"additionalProperties":{"const":true}}
      }
    },
    "optimization_performed":{"const":false},
    "outcomes_generated":{"const":false},
    "post_holdout_thresholds_introduced":{"const":false},
    "prohibited_modules":{"type":"array","maxItems":0},
    "raw_csv_accessed":{"const":false},
    "runtime_audit":{
      "type":"object","additionalProperties":false,
      "required":["module_import_counts","prohibited_execution_counts","external_process","blocked_detector_import_requests","file_access","counter_provenance"],
      "properties":{
        "module_import_counts":{"type":"object","minProperties":7,"additionalProperties":{"const":0}},
        "prohibited_execution_counts":{"type":"object","minProperties":13,"additionalProperties":{"const":0}},
        "external_process":{"type":"object","additionalProperties":false,"required":["successful_launch_count","blocked_launch_count"],"properties":{"successful_launch_count":{"const":0},"blocked_launch_count":{"minimum":1}}},
        "blocked_detector_import_requests":{"minimum":1},
        "file_access":{"type":"object","additionalProperties":false,"required":["unique_logical_file_counts","raw_read_operation_counts","unauthorized_successful_read_count"],"properties":{"unique_logical_file_counts":{"type":"object"},"raw_read_operation_counts":{"type":"object"},"unauthorized_successful_read_count":{"const":0}}},
        "counter_provenance":{"type":"object","minProperties":4,"additionalProperties":{"type":"string","minLength":1}}
      }
    },
    "schema_version":{"const":"fr_prep_b5_event_population_research_decision.v1"},
    "strategy_or_parameter_changes":{"const":false},
    "strategy_performance_status":{"const":"NOT_EVALUATED"},
    "tp_sl_calculated":{"const":false}
  },
  "required":[
    "schema_version","checkpoint","decision","evidence_validation","fj","fq","cross_period_comparison",
    "conclusions","explicit_statements","mismatch_counters","negative_tests","runtime_audit",
    "prohibited_modules","execution_status","strategy_performance_status","post_holdout_thresholds_introduced",
    "strategy_or_parameter_changes","raw_csv_accessed","atr_events_generated","tp_sl_calculated",
    "outcomes_generated","fn_interpretation_performed","optimization_performed","mt5_executed","ea_executed",
    "absolute_runtime_path_in_canonical_identity_count","canonical_summary_sha256"
  ],
  "type":"object",
  "$defs":{
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["decision","canonical_summary_sha256","contract_schema_validated","identity_validated","result_projection_validated","mismatch_count_zero"],
      "properties":{
        "decision":{"type":"string"},"canonical_summary_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "contract_schema_validated":{"const":true},"identity_validated":{"const":true},
        "result_projection_validated":{"const":true},"mismatch_count_zero":{"const":true}
      }
    },
    "variation":{
      "type":"object","additionalProperties":false,"required":["minimum","maximum","range","mean","population_standard_deviation","coefficient_of_variation_percent"],
      "properties":{
        "minimum":{"type":"integer"},"maximum":{"type":"integer"},"range":{"type":"integer"},
        "mean":{"type":"number"},"population_standard_deviation":{"type":"number"},"coefficient_of_variation_percent":{"type":"number"}
      }
    },
    "dataset_metrics":{
      "type":"object","additionalProperties":false,
      "required":["role","dataset_id","bars","events","events_per_1000_bars","long","short","long_share_percent","short_share_percent","years","year_count_variation","gaps","accepted_closures","unverified_gaps","unverified_gap_share_percent","fail_closed_gaps_per_1000_bars","data_incomplete_gap_exclusions"],
      "properties":{
        "role":{"type":"string"},"dataset_id":{"type":"string"},"bars":{"type":"integer"},"events":{"type":"integer"},
        "events_per_1000_bars":{"type":"number"},"long":{"type":"integer"},"short":{"type":"integer"},
        "long_share_percent":{"type":"number"},"short_share_percent":{"type":"number"},"years":{"type":"object"},
        "year_count_variation":{"$ref":"#/$defs/variation"},"gaps":{"type":"integer"},"accepted_closures":{"type":"integer"},
        "unverified_gaps":{"type":"integer"},"unverified_gap_share_percent":{"type":"number"},
        "fail_closed_gaps_per_1000_bars":{"type":"number"},"data_incomplete_gap_exclusions":{"type":"integer"}
      }
    },
    "fj_metrics":{
      "allOf":[
        {"$ref":"#/$defs/dataset_metrics"},
        {"properties":{"role":{"const":"FROZEN_DEVELOPMENT_REPLAY"},"dataset_id":{"const":"FJ_2023_2025_GOLD_H1"},"bars":{"const":17716},"events":{"const":1079},"events_per_1000_bars":{"const":60.905396},"long":{"const":588},"short":{"const":491},"long_share_percent":{"const":54.494903},"short_share_percent":{"const":45.505097},"years":{"const":{"2023":352,"2024":376,"2025":351}},"year_count_variation":{"const":{"minimum":351,"maximum":376,"range":25,"mean":359.666667,"population_standard_deviation":11.556624,"coefficient_of_variation_percent":3.213148}},"gaps":{"const":773},"accepted_closures":{"const":745},"unverified_gaps":{"const":28},"unverified_gap_share_percent":{"const":3.622251},"fail_closed_gaps_per_1000_bars":{"const":1.580492},"data_incomplete_gap_exclusions":{"const":13}}}
      ]
    },
    "fq_metrics":{
      "allOf":[
        {"$ref":"#/$defs/dataset_metrics"},
        {"properties":{"role":{"const":"SEALED_HOLDOUT_REPLAY"},"dataset_id":{"const":"FP_FQ_2020_2022_GOLD_H1"},"bars":{"const":17731},"events":{"const":493},"events_per_1000_bars":{"const":27.804410},"long":{"const":252},"short":{"const":241},"long_share_percent":{"const":51.115619},"short_share_percent":{"const":48.884381},"years":{"const":{"2020":149,"2021":181,"2022":163}},"year_count_variation":{"const":{"minimum":149,"maximum":181,"range":32,"mean":164.333333,"population_standard_deviation":13.097922,"coefficient_of_variation_percent":7.970338}},"gaps":{"const":774},"accepted_closures":{"const":149},"unverified_gaps":{"const":625},"unverified_gap_share_percent":{"const":80.749354},"fail_closed_gaps_per_1000_bars":{"const":35.248999},"data_incomplete_gap_exclusions":{"const":347}}}
      ]
    },
    "comparison":{
      "type":"object","additionalProperties":false,
      "required":["fq_to_fj_event_density_ratio","fq_event_density_reduction_percent","fq_minus_fj_long_share_percentage_points","fq_minus_fj_short_share_percentage_points","fq_minus_fj_total_gaps","fq_minus_fj_accepted_closures","fq_minus_fj_unverified_gaps","fq_minus_fj_unverified_gap_share_percentage_points","fq_minus_fj_fail_closed_gaps_per_1000_bars","fq_to_fj_fail_closed_gap_rate_ratio","fq_minus_fj_data_incomplete_gap_exclusions"],
      "properties":{
        "fq_to_fj_event_density_ratio":{"const":0.456518},
        "fq_event_density_reduction_percent":{"const":54.348199},
        "fq_minus_fj_long_share_percentage_points":{"const":-3.379284},
        "fq_minus_fj_short_share_percentage_points":{"const":3.379284},
        "fq_minus_fj_total_gaps":{"const":1},
        "fq_minus_fj_accepted_closures":{"const":-596},
        "fq_minus_fj_unverified_gaps":{"const":597},
        "fq_minus_fj_unverified_gap_share_percentage_points":{"const":77.127103},
        "fq_minus_fj_fail_closed_gaps_per_1000_bars":{"const":33.668507},
        "fq_to_fj_fail_closed_gap_rate_ratio":{"const":22.302545},
        "fq_minus_fj_data_incomplete_gap_exclusions":{"const":334}
      }
    },
    "conclusions":{
      "type":"object","additionalProperties":false,
      "required":["event_population_replay_integrity","cross_period_event_presence","directional_coverage","event_density_stability","data_quality_comparability","strategy_performance","profitability","order_logic","candidate","next_allowed_scope"],
      "properties":{
        "event_population_replay_integrity":{"const":"PROVEN"},"cross_period_event_presence":{"const":"PROVEN"},
        "directional_coverage":{"const":"PROVEN"},"event_density_stability":{"const":"NOT_PROVEN"},
        "data_quality_comparability":{"const":"MATERIAL_LIMITATION"},"strategy_performance":{"const":"NOT_EVALUATED"},
        "profitability":{"const":"NOT_CLAIMED"},"order_logic":{"const":"NOT_APPROVED"},
        "candidate":{"const":"NOT_READY_FOR_ORDER_LOGIC"},"next_allowed_scope":{"const":"OUTCOME_CONTRACT_DESIGN_ONLY"}
      }
    }
  }
}
